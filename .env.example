# Copy to .env and fill in values:
#   cp .env.example .env          (Unix)
#   Copy-Item .env.example .env   (PowerShell)
# Or run: scripts/install_dev.ps1 / scripts/install_dev.sh

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Ollama（v0.1 預設大模型來源，OpenAI 相容 API）---
# 需先安裝 Ollama 並 pull 模型，例如：ollama pull gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e2b
# v2.0+ 程式內亦可寫 model="ollama/gemma4:e2b"（與裸名等價）
# 本機 Ollama 通常不需金鑰；若端點要求可填占位值
OLLAMA_API_KEY=

# --- 回覆語言（可選；留空則使用程式內建繁體中文提示）---
AICENTRAL_SYSTEM_PROMPT=請一律使用繁體中文（臺灣正體）回覆，用語自然簡潔。若使用者使用其他語言提問，仍以繁體中文回答。

# --- 雲端 API（v0.4+，第一版可忽略）---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
