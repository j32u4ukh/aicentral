# Copy to .env and fill in values:
#   cp .env.example .env          (Unix)
#   Copy-Item .env.example .env   (PowerShell)
# Or run: scripts/install_dev.ps1 / scripts/install_dev.sh

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- LiteLLM proxy (optional) ---
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-change-me

# --- LLM provider API keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Database (optional, for LiteLLM with DB) ---
# DATABASE_URL=postgresql://aicentral:aicentral@localhost:5432/aicentral
