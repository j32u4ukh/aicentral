# Copy to .env and fill in values:
#   cp .env.example .env          (Unix)
#   Copy-Item .env.example .env   (PowerShell)
# Or run: scripts/install_dev.ps1 / scripts/install_dev.sh

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- 預設模型（呼叫端未傳 complete(..., model=...) 時使用）---
# 優先序：參數 model > 本變數 > config/aicentral.yaml defaults.model > ollama/OLLAMA_MODEL
# 可寫：provider/model_id（如 ollama/gemma4:e2b）、裸名（視為 ollama）、或 yaml 別名（需 AICENTRAL_CONFIG）
# 僅在 .env 填寫其他 API 金鑰不會自動切換；要換雲端請改此處或呼叫時指定 model。
AICENTRAL_DEFAULT_MODEL=ollama/gemma4:e2b

# --- Ollama（本機 OpenAI 相容 API）---
# 需先安裝 Ollama 並 pull 模型，例如：ollama pull gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e2b
# v2.0+ 程式內亦可寫 model="ollama/gemma4:e2b"（與裸名等價）
OLLAMA_API_KEY=

# --- 回覆語言（可選；留空則使用程式內建繁體中文提示）---
AICENTRAL_SYSTEM_PROMPT=請一律使用繁體中文（臺灣正體）回覆，用語自然簡潔。若使用者使用其他語言提問，仍以繁體中文回答。

# --- 開發模式（除錯資訊輸出至 stderr）---
# AICENTRAL_DEV=1

# --- 結構化輸出（v3.0 / complete_structured）---
# 單次呼叫；重試由消費方負責（可 from aicentral import append_retry_hint）
# tool（預設，tool_calls）| json（從 message.content 解析 JSON）
AICENTRAL_STRUCTURED_MODE=tool

# --- 設定檔（v4.0，可選）---
# 啟用後 model 可用 yaml 別名（如 local-chat）；未設則僅靠上方 env 與 provider/model 字串
# AICENTRAL_CONFIG=./config/aicentral.yaml

# --- OpenAI 雲端（僅在 model 含 openai/ 或 yaml 別名指向 openai 時使用）---
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# --- Anthropic（僅在 model 含 anthropic/ 或 yaml 別名指向 anthropic 時使用）---
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01

# --- Google Gemini（僅在 model 含 gemini/ 或 yaml 別名指向 gemini 時使用）---
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# --- MCP（僅在 MCPManager / mcp_servers 條目需要時填寫）---
# LINEAR_API_KEY=
