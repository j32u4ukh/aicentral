# Copy to docker/.env before running docker compose:
#   cp docker/.env.example docker/.env

# --- aicentral app ---
APP_ENV=production
LOG_LEVEL=INFO

# --- LiteLLM proxy ---
LITELLM_MASTER_KEY=sk-change-me-before-production
LITELLM_PROXY_URL=http://litellm:4000

# --- LLM provider keys (passed to LiteLLM / app) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- PostgreSQL (used by LiteLLM when enabled) ---
POSTGRES_USER=aicentral
POSTGRES_PASSWORD=aicentral
POSTGRES_DB=aicentral
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
